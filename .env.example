# Environment Variables for AniDex Reader

# Server
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AniList API (no key required for public API)
ANILIST_API_URL=https://graphql.anilist.co

# MangaDex API (no key required for public API)
MANGADEX_API_URL=https://api.mangadex.org

# Optional: Database (for user data)
# DATABASE_URL=postgresql://user:password@localhost:5432/anidex
# MONGODB_URI=mongodb://localhost:27017/anidex

# Optional: Auth
# JWT_SECRET=your-super-secret-jwt-key
# NEXTAUTH_SECRET=your-nextauth-secret
# NEXTAUTH_URL=http://localhost:3000

# Optional: Suwayomi Backend
# SUWAYOMI_URL=http://localhost:4567
