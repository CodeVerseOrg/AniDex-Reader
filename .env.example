# Environment Variables for AniDex Reader

# Server
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AniList API (no key required for public API)
ANILIST_API_URL=https://graphql.anilist.co

# Telegram Bot (for manga image storage and caching)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_STORAGE_CHAT_ID=-your-channel-or-group-id

# Optional: Database (for user data)
# DATABASE_URL=postgresql://user:password@localhost:5432/anidex
# MONGODB_URI=mongodb://localhost:27017/anidex

# Optional: Auth
# JWT_SECRET=your-super-secret-jwt-key
# NEXTAUTH_SECRET=your-nextauth-secret
# NEXTAUTH_URL=http://localhost:3000
